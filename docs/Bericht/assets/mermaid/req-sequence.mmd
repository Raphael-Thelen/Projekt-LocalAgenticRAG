%% UML Sequence Diagram (Mermaid, Schwarz-Weiss)
sequenceDiagram
    autonumber
    actor U as Nutzer
    participant C as LLM-Client
        participant M as LLM-Provider
        participant S as MCP-Server
        participant E as ElasticSearch

    U->>C: Frage stellen
        C->>S: initialize()
        C->>S: list_tools()
        S-->>C: Verfuegbare Tools
        C->>M: Erste Chat-Anfrage mit Tool-Schemas
        M-->>C: Antwort (optional mit tool_calls)

        opt tool_calls vorhanden
            loop fuer jeden Tool-Call
                C->>S: call_tool(name, args)
                S->>E: Query DSL auf lara_documents
                E-->>S: Treffer + Scores + Metadaten
                S-->>C: JSON Payload (results, count)
            end
            C->>M: Finale Chat-Anfrage mit Tool-Ergebnissen
            M-->>C: Antwort mit Belegen
        end

        opt keine tool_calls
            C-->>U: Direkte Modellantwort
        end

        C-->>U: Finale Antwort
